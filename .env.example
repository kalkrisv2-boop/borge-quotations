# Copy this file to `.env` (which is gitignored — see .gitignore) and fill in real
# values. Without a .env file, the app still runs: it seeds a generic placeholder
# tenant and NO login-capable user at all (see src-tauri/src/seed.rs's safe-by-default
# behavior — there is deliberately no working "default password" baked into the binary).

# --- Tenant / company details shown on quotes and PDFs ---
SEED_TENANT_ID=t-example-tenant-001
SEED_TENANT_NAME=Example Equipment Rental LLC
SEED_TENANT_NAME_AR=مثال لتأجير المعدات
SEED_TENANT_TAGLINE_AR=مثال - ليس بيانات حقيقية
SEED_TENANT_PO_BOX=P.O. Box: 00000
SEED_TENANT_CITY=Example City
SEED_TENANT_PHONE_1=+971 50 0000000
SEED_TENANT_PHONE_2=+971 56 0000000
SEED_TENANT_EMAIL=info@example.com
SEED_TENANT_WEBSITE=www.example.com
SEED_TENANT_VAT_TRN=000000000000000

# --- Admin login (required to actually log in locally) ---
# SEED_USER_EMAIL / SEED_USER_PASSWORD_HASH must BOTH be set, or no user is seeded at
# all. SEED_USER_PASSWORD_HASH must be a real PBKDF2-SHA512 hash in the
# "{salt_hex}${hash_hex}" format auth::hash_password() produces -- NOT a plaintext
# password. Generate one with:
#   cd src-tauri && cargo run --example hash_password -- "YourRealPasswordHere"
# (see src-tauri/examples/hash_password.rs)
SEED_USER_ID=u-example-admin-01
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD_HASH=
SEED_USER_FULL_NAME=Example Admin
SEED_USER_PHONE=+971 50 0000000

# --- Optional demo content ---
# Set to 1 to also seed one sample quote (generic placeholder line item) for
# exercising save/fetch/restart-persistence and PDF export locally.
SEED_SAMPLE_QUOTE=0
