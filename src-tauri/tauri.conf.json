{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "borge-equipment-rental",
  "version": "0.1.0",
  "identifier": "com.borge.equipmentrental",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Borge Equipment Rental & Quotation System",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
